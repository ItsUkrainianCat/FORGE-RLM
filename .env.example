# Model endpoint
FORGE_MODEL_ID=qwen-local
FORGE_API_BASE=http://127.0.0.1:8080/v1
FORGE_API_KEY=local
FORGE_SUB_MODEL_ID=
FORGE_CRITIC_MODEL_ID=
FORGE_REFLECTION_MODEL_ID=

# Inference
FORGE_TEMPERATURE=0.2
FORGE_MAX_TOKENS=4096
FORGE_RLM_MAX_ITERS=10
FORGE_RLM_MAX_LLM_CALLS=24
FORGE_RLM_MAX_OUTPUT_CHARS=10000

# Research state
FORGE_GENOME_PATH=config/genome.yaml
FORGE_BEST_KNOWN_PATH=artifacts/checkpoints/BEST_KNOWN.json
FORGE_EXPERIMENT_DIR=experiments
FORGE_TRACE_DIR=artifacts/traces

# Memory
FORGE_RVF_PATH=memory/project.rvf
FORGE_RUVECTOR_ENDPOINT=
FORGE_MEMORY_ENABLED=false

# Sealed holdout is intentionally outside tracked eval directories.
FORGE_HOLDOUT_DIR=.forge/holdout
FORGE_ALLOW_HOLDOUT=false

# Tracking
FORGE_MLFLOW_URI=
